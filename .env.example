# ==============================================================================
# Environment Configuration
# ==============================================================================
NODE_ENV=production
PORT=5000

# ==============================================================================
# Database Configuration (PostgreSQL)
# ==============================================================================
POSTGRES_DB=e_production
POSTGRES_USER=e_admin
POSTGRES_PASSWORD=generate_a_secure_minimum_32_char_alphanumeric_password_here
# Assembled connection string for local non-Docker development if needed:
DATABASE_URL=postgres://e_admin:password@localhost:5432/e_production

# ==============================================================================
# Redis Cache & Distributed Rate Limiting
# ==============================================================================
REDIS_PASSWORD=generate_a_secure_minimum_32_char_redis_password_here
REDIS_URL=redis://:password@redis:6379

# ==============================================================================
# Cryptographic Secrets & Token Lifecycle
# ==============================================================================
# Generate with: openssl rand -base64 64
JWT_ISSUER=e-api
JWT_AUDIENCE=e-web
JWT_SECRET=generate_a_minimum_64_byte_random_string_for_jwt_signing_here
# Argon2id Pepper (Additional server-side cryptographic secret):
PASSWORD_PEPPER=
OTP_HMAC_SECRET=generate_a_minimum_32_byte_random_string_for_password_pepper_here

# ==============================================================================
# Domain & CORS Origins (Strict White-listing)
# ==============================================================================
# The exact frontend origin exposed via Cloudflare:
FRONTEND_URL=
# Root domain name used for domain boundary checks:
FRONTEND_DOMAIN=

# ==============================================================================
# Cloudflare Tunnel Configuration
# ==============================================================================
CLOUDFLARE_TUNNEL_TOKEN=eyJhIjoiZXhhbXBsZXRva2Vu...

# ==============================================================================
# Founder & Initial SuperAdmin Auto-Provisioning
# ==============================================================================
# Required: must be a valid email address (the app refuses to start otherwise).
FOUNDER_EMAIL=founder@example.com
# Optional: leave these two lines commented out unless you want a service account.
# An empty value is NOT accepted by the env validator.
# SERVICE_ACCOUNT_EMAIL=service@example.com
# SERVICE_ACCOUNT_PASSWORD=change_this_service_account_password


# ==============================================================================
# SMTP Mail Transport Configuration
# ==============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=noreply@example.com
SMTP_PASS=app_specific_generated_password_here
SMTP_FROM="University Residence Portal" <noreply@example.com>

# ==============================================================================
# Mapping Services
# ==============================================================================
CARTO_API_KEY=your_carto_maps_api_key_here
# Google Maps Embed API is a browser-side/public key. Put it in client/.env as REACT_APP_GOOGLE_MAPS_EMBED_API_KEY.
# Restrict the key by HTTP referrer and enable only Maps Embed API in Google Cloud.

# Cloudflare Turnstile
# The site key is public and is also passed to the React build.
# Official invisible test pair (testing only):
TURNSTILE_SITE_KEY=1x00000000000000000000BB
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# IMPORTANT: official test tokens report action="test", so enable this only
# when using the dummy/test secret above.
TURNSTILE_TEST_MODE=true
# Comma-separated real production hostnames, without https://.
# Leave empty for local/test mode.
TURNSTILE_ALLOWED_HOSTNAMES=



# --- Text moderation ---
# In production the server rejects all text if the ONNX model is missing.
# Set to true only to temporarily allow regex-only filtering.
# TEXT_MODERATION_ALLOW_REGEX_ONLY=false

# Uploaded images are only served to requests with a valid, verified session.
# true (default): public profile content of a visible resident stays reachable
#   without login: public photos/avatar and bacheca images (bacheca privacy public).
# false: EVERY image requires a session, including all of the above.
# UPLOADS_ANON_PUBLIC_PHOTOS=true

# Moderation tuning (see src/localModeration.js)
# TEXT_MODERATION_THRESHOLD=0.93
# TEXT_MODERATION_MIN_WORDS=4
