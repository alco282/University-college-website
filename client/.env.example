# React environment variables are embedded into the browser bundle at build time.
# This is a PUBLIC key; never put TURNSTILE_SECRET_KEY here.
REACT_APP_TURNSTILE_SITE_KEY=1x00000000000000000000BB

# Public Google Maps Embed API key. Restrict it by HTTP referrer and enable Maps Embed API.
REACT_APP_GOOGLE_MAPS_EMBED_API_KEY=

# Optional city appended to addresses in map lookups (e.g. "Paris, France"). Leave empty to disable.
REACT_APP_CITY_NAME=
